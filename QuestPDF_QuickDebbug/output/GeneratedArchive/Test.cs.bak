    private void Compose(IDocumentContainer container, InvoiceModel model)
    {
        container.Page(page =>
        {
            page.Size(PageSizes.Letter.Portrait());
            page.MarginTop(20f);
            page.MarginRight(20f);
            page.MarginBottom(20f);
            page.MarginLeft(20f);
            page.DefaultTextStyle(x => x.FontSize(10f).FontFamily("Liberation Sans").FontColor("#000000"));

            page.Header().Column(col => ComposeHeader(col, model));
            page.Content().Column(content => ComposeContent(content, model));
            page.Footer().Column(col => ComposeFooter(col, model));
        });
    }

