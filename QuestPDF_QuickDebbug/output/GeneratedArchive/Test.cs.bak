private static void RegisterEncodingProvider()
{
    if (_encodingProviderRegistered) return;
    lock (_lock)
    {
        if (_encodingProviderRegistered) return;
        try
        {
            Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
            _encodingProviderRegistered = true;
        }
        catch
        {
            _encodingProviderRegistered = false;
        }
    }
}

private static string SafeGetValue(string? value) => value ?? string.Empty;

private static string GetCustomField(InvoiceModel model, string key, string defaultValue = "")
    => model.Additional?.CustomFields?.TryGetValue(key, out var value) == true && !string.IsNullOrEmpty(value)
        ? value
        : defaultValue;

private static bool Bool(string? value)
    => value != null && (value.Equals("1", StringComparison.OrdinalIgnoreCase)
        || value.Equals("true", StringComparison.OrdinalIgnoreCase)
        || value.Equals("si", StringComparison.OrdinalIgnoreCase)
        || value.Equals("s", StringComparison.OrdinalIgnoreCase));

private static string Format(object? value, string? format)
{
    if (value == null) return string.Empty;
    var text = value switch
    {
        DateTime dt => dt.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
        decimal dec => dec.ToString(CultureInfo.InvariantCulture),
        double dbl => dbl.ToString(CultureInfo.InvariantCulture),
        IFormattable f => f.ToString(null, CultureInfo.InvariantCulture),
        _ => value.ToString() ?? string.Empty
    };
    if (string.IsNullOrWhiteSpace(format) || format == "text") return text;

    var culture = CultureInfo.GetCultureInfo("es-CO");
    if (format.StartsWith("date:", StringComparison.OrdinalIgnoreCase))
    {
        return DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date.ToString(format[5..], culture)
            : text;
    }

    decimal? num = decimal.TryParse(text.Replace("$", "").Replace(",", "").Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var n)
        ? n : null;

    return format switch
    {
        "currency" => num?.ToString("C0", culture) ?? text,
        "currency2" => num?.ToString("C2", culture) ?? text,
        "number" => num?.ToString("N0", culture) ?? text,
        "number2" => num?.ToString("N2", culture) ?? text,
        "upper" => text.ToUpperInvariant(),
        "lower" => text.ToLowerInvariant(),
        _ => text
    };
}

private static byte[]? SafeLoadImage(string? source)
{
    if (string.IsNullOrWhiteSpace(source)) return null;
    try
    {
        if (source.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            var idx = source.IndexOf("base64,", StringComparison.OrdinalIgnoreCase);
            if (idx >= 0) return Convert.FromBase64String(source[(idx + 7)..]);
        }
        if (File.Exists(source)) return File.ReadAllBytes(source);
        return Convert.FromBase64String(source);
    }
    catch
    {
        return null;
    }
}

private static void Canvas(IContainer container, Action<SKCanvas, QuestPDF.Infrastructure.Size> draw)
{
    container.Svg(size =>
    {
        using var stream = new MemoryStream();
        using (var canvas = SKSvgCanvas.Create(new SKRect(0, 0, size.Width, size.Height), stream))
            draw(canvas, size);
        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    });
}

private static void DrawShape(IContainer cell, string shape, float radius, float pt, float pr, float pb, float pl, string? fill, string? border, float borderWidth)
{
    var box = cell;
    if (pt > 0) box = box.PaddingTop(pt);
    if (pr > 0) box = box.PaddingRight(pr);
    if (pb > 0) box = box.PaddingBottom(pb);
    if (pl > 0) box = box.PaddingLeft(pl);

    if (shape == "rectangle")
    {
        if (fill != null) box = box.Background(fill);
        if (border != null) box = box.Border(borderWidth).BorderColor(border);
        return;
    }

    var fillColor = string.IsNullOrWhiteSpace(fill) ? SKColors.Transparent : SKColor.Parse(fill);
    var borderColor = string.IsNullOrWhiteSpace(border) ? SKColors.Black : SKColor.Parse(border);
    var ellipse = shape == "ellipse";

    Canvas(box, (canvas, size) =>
    {
        var rect = new SKRect(0, 0, size.Width, size.Height);
        using (var paint = new SKPaint
               {
                   IsAntialias = true,
                   Style = fill != null ? SKPaintStyle.Fill : SKPaintStyle.Stroke,
                   Color = fill != null ? fillColor : borderColor,
                   StrokeWidth = borderWidth
               })
        {
            if (ellipse) canvas.DrawOval(rect, paint);
            else canvas.DrawRoundRect(rect, radius, radius, paint);
        }

        if (fill != null && border != null)
        {
            using var stroke = new SKPaint
            {
                IsAntialias = true,
                Style = SKPaintStyle.Stroke,
                Color = borderColor,
                StrokeWidth = borderWidth
            };
            if (ellipse) canvas.DrawOval(rect, stroke);
            else canvas.DrawRoundRect(rect, radius, radius, stroke);
        }
    });
}

private static void DrawBarcode(IContainer cell, string? value, string symbology, float height)
{
    if (string.IsNullOrWhiteSpace(value))
    {
        cell.Text("");
        return;
    }

    var format = symbology.ToUpperInvariant() switch
    {
        "QR" or "QRCODE" => BarcodeFormat.QR_CODE,
        "CODE_39" => BarcodeFormat.CODE_39,
        "EAN_13" => BarcodeFormat.EAN_13,
        _ => BarcodeFormat.CODE_128
    };

    var writer = new BarcodeWriter
    {
        Format = format,
        Options = new() { Height = (int)(height * 3), Width = 600, PureBarcode = format != BarcodeFormat.QR_CODE, Margin = 0 }
    };

    using var bitmap = writer.Write(value);
    Canvas(cell, (canvas, size) =>
    {
        float scale = Math.Min(size.Width / bitmap.Width, size.Height / bitmap.Height);
        float w = bitmap.Width * scale;
        float h = bitmap.Height * scale;
        canvas.DrawBitmap(bitmap, new SKRect((size.Width - w) / 2, (size.Height - h) / 2, (size.Width + w) / 2, (size.Height + h) / 2));
    });
}
}
