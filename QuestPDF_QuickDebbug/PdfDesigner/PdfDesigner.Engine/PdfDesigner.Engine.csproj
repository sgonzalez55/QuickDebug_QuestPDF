<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfQuickDebug.Designer</RootNamespace>
    <AssemblyName>PdfDesigner.Engine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DebugPDF\PdfQuickDebug\PdfQuickDebug.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI web del diseñador: se copia al output respetando la ruta que espera DesignerUiServer -->
    <Content Include="UI\**\*" Link="Designer\UI\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>