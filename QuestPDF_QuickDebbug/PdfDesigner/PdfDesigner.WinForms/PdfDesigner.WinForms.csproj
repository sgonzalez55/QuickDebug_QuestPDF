<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfQuickDebug.Designer.WinForms</RootNamespace>
    <AssemblyName>PdfDesigner.WinForms</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfDesigner.Engine\PdfDesigner.Engine.csproj" />
    <ProjectReference Include="..\..\DebugPDF\PdfQuickDebug\PdfQuickDebug.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\DebugPDF\PdfQuickDebug\Assets\Fonts\LiberationSans-Regular.ttf"
          Link="Assets\Fonts\LiberationSans-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
